# ==========================================
# AstroKraft Monorepo Master Environment Configuration
# ==========================================

# ------------------------------------------
# Cloudflare R2 Object Storage (@astrokraft/storage)
# ------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=0917be08d98e55709e3ce1c65ffef51a
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=astrokraft-media
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=https://media.astrokraft.online

# ------------------------------------------
# Clerk Authentication (@astrokraft/auth)
# ------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------
# Supabase Database (@astrokraft/db)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ------------------------------------------
# Razorpay Payments (@astrokraft/payments)
# ------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------
# Resend Transactional Email (apps/web — order & consultation invoices)
# ------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
# Optional — defaults to the Resend sandbox sender (onboarding@resend.dev),
# which only delivers to the Resend account owner's own inbox. Set this to a
# verified astrokraft.online sender before sending invoices to real customers.
RESEND_FROM_EMAIL=
