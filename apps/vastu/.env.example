# Supabase (same project as AstroKraft). Service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=
# Public reads only (approved AstroKraft reviews shown as testimonials)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this landing page (used for Meta CAPI event_source_url)
NEXT_PUBLIC_SITE_URL=https://vastu.example.com

# Cal.com — "username/event-slug" of the FREE event type (payment is Razorpay)
NEXT_PUBLIC_CAL_LINK=biprangshu/business-vastu-consultation
# Optional separate Cal.com event for /business-vastu bookings (same setup:
# FREE, "Requires confirmation" on). Falls back to NEXT_PUBLIC_CAL_LINK.
NEXT_PUBLIC_CAL_LINK_BUSINESS=
# https://cal.com for Cal.com cloud; your own domain if self-hosted
NEXT_PUBLIC_CAL_ORIGIN=https://cal.com
# Secret set on the Cal.com webhook -> https://<site>/api/webhooks/cal
CAL_WEBHOOK_SECRET=
# Cal.com API key (Settings → Developer → API keys). Used to confirm a booking
# once its Razorpay payment succeeds — the event type has "Requires confirmation" on.
CAL_API_KEY=

# Business Vastu (/business-vastu) price in rupees. Optional, default 1999.
NEXT_PUBLIC_BUSINESS_CONSULTATION_FEE=

# Optional fee override in rupees, e.g. 20 for a live test payment. REMOVE after
# testing — it overrides BOTH pages' fees (flat and business): the amount
# charged and the prices shown.
NEXT_PUBLIC_CONSULTATION_FEE=

# Razorpay (₹999 flat / ₹1,999 business by default, charged on /pay/<leadId> after the Cal.com booking)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret set on the Razorpay webhook -> https://<site>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Resend (same key as apps/web) — emails each PAID booking to Biprangshu
# (vastubipra@gmail.com, cc the team) with the client details and join link.
RESEND_API_KEY=
# Optional sender override; default "VASTU by Biprangshu <bookings@mail.astrokraft.online>"
VASTU_NOTIFY_FROM=

# Meta Pixel + Conversions API (optional — tracking is skipped when unset)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Only while testing in Events Manager > Test events
META_CAPI_TEST_EVENT_CODE=
